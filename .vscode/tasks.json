{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      // ★ launch.json의 preLaunchTask 이름과 100% 일치해야 함
      "label": "C/C++: gcc build active file", 
      "command": "gcc",
      "args": [
        "-g",
        "${file}",
        "-o",
        // launch.json의 program 경로와 동일하게 설정
        "${fileDirname}/${fileBasenameNoExtension}.exe" 
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "shell",
      "label": "Build FSM terminal demo",
      "command": "gcc",
      "args": [
        "-std=c11",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-g",
        "${workspaceFolder}/fsm_cli_demo.c",
        "${workspaceFolder}/fsm_cli_ui.c",
        "${workspaceFolder}/fsm_practice.c",
        "-o",
        "${workspaceFolder}/fsm_cli_demo.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": "build"
    }
  ]
}
